# Copiar este archivo como .env y completar los valores.
# NUNCA subir el archivo .env al repositorio.

# Región del AWS Academy Learner Lab (fija)
AWS_REGION=us-east-1

# Bucket único del data lake (debe ser globalmente único, en minúsculas)
NOMBRE_BUCKET=

# Conexión a RDS MariaDB
RDS_HOST=
RDS_PUERTO=3306
RDS_USUARIO=
RDS_CLAVE=
RDS_BASE=movilidad
