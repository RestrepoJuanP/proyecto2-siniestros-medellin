# Copiar este archivo como .env y completar los valores.
# NUNCA subir el archivo .env al repositorio.

# Región del AWS Academy Learner Lab (fija)
AWS_REGION=us-east-1

# Bucket único del data lake (debe ser globalmente único, en minúsculas)
NOMBRE_BUCKET=

# Conexión a RDS MariaDB
RDS_HOST=
RDS_PUERTO=3306
RDS_USUARIO=
RDS_CLAVE=
RDS_BASE=movilidad

# URLs públicas de las fuentes (Punto 1 exploración / Punto 3 ingesta).
# Si se dejan vacías, los scripts usan estos mismos valores por defecto.
URL_ARCGIS_ACCIDENTES=https://www.medellin.gov.co/servidormapas/rest/services/transporte/VM_Accidentes/MapServer/0
URL_ARCGIS_POBLACION=https://www.medellin.gov.co/servidormapas/rest/services/mapas_nacionales/VC_Distribucion_Poblacional/MapServer/1
URL_OPENMETEO_ARCHIVO=https://archive-api.open-meteo.com/v1/archive
